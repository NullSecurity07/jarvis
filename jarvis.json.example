{
  "name": "JARVIS",
  "port": 8794,
  "res": "1280x720",
  "fps": "auto",
  "orbs": [
    { "title": "Notes", "path": "sample-notes", "kind": "notes" },
    { "title": "Props", "path": "media",        "kind": "media" }
  ],
  "files": {
    "roots": [
      { "title": "Documents", "path": "~/Documents" },
      { "title": "Desktop",   "path": "~/Desktop" }
    ],
    "maxBytes": 52428800
  },
  "desks": {
    "enabled": true,
    "fps": 4,
    "minGapMs": 180,
    "maxStreams": 3,
    "display": ":0",
    "xauthority": "/run/user/1000/lyxauth"
  }
}

